# Copy to .env (git-ignored) and uncomment what you use. Variables already set in the shell win;
# blank values are ignored.

# Weights & Biases: metrics mirror. WANDB_MODE: online (default) | offline (sync later) | disabled.
# WANDB_API_KEY=your-api-key
# WANDB_ENTITY=your-team
# WANDB_MODE=offline

# Hugging Face Hub: gated model and dataset downloads; HF_HOME moves the model cache.
# HF_TOKEN=hf_your-token
# HF_HOME=/path/to/large/disk/hf

# Judge: any OpenAI-compatible endpoint (a local inference server or a hosted API).
# JUDGE_API_BASE=http://localhost:8000/v1
# JUDGE_API_KEY=your-api-key
# JUDGE_MODEL=judge-model-name

# Storage: large disks for data and run outputs (defaults: ./data and ./runs).
# DATA_DIR=/path/to/large/disk/data
# RUNS_DIR=/path/to/large/disk/runs

# Remote copy of data and run outputs on any S3-compatible object storage, as an rclone
# remote and path. Define the remote once with `rclone config` (type s3, the provider's endpoint,
# env_auth = true); it then reads the two AWS_* keys below.
# ARTIFACT_REMOTE=store:bucket/zero-field-refusal
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
